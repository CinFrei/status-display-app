{
    "manifest_version": 2,
    "name": "Custom CSS Injector",
    "version": "1.0",
    "description": "Inject custom CSS into webpages",
    "permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "custom.css"
            ],
            "run_at": "document_start"
        }
    ]
}